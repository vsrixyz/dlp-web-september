---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import { Heading, Link } from 'accessible-astro-components'
---

<DefaultLayout title="Page not found">
  <section class="my-24">
    <div class="narrow space-content container">
      <Heading level="h1">Page not found</Heading>
      <p class="text-2xl">There's nothing at this address.</p>
      <p>
        The link may be out of date, or the page may have moved. If you followed a link on this site to get here, we'd
        like to know, because that's a broken link and it's ours to fix. Email <Link
          href="mailto:hola@delapractica.com">hola@delapractica.com</Link
        >.
      </p>
      <div class="flex flex-wrap gap-4">
        <Link href="/" isButton type="primary" animateOnHover animationType="boop">Back to the home page</Link>
        <Link href="/contact" isButton type="secondary" animateOnHover animationType="boop">Contact</Link>
      </div>
    </div>
  </section>
</DefaultLayout>

---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PageHeader from '@components/PageHeader.astro'
import { Heading, Link } from 'accessible-astro-components'
import { Image } from 'astro:assets'
import heroImage from '@assets/img/hero.jpeg'
---

<DefaultLayout
  title="About"
  description="Jen Macias De La Parra is the founder of De La Practica, an experience design consultancy that focuses on accessible travel and tourism."
>
  <PageHeader title="About" subtitle="Accessibility is about people not paperwork." bgType="bordered" />

  <section class="my-16">
    <div class="container">
      <div class="grid items-start gap-10 md:grid-cols-2 lg:gap-16">
        <div class="space-content">
          <Heading level="h2">Jen Macias De La Parra</Heading>
          <p>
            Jen Macias De La Parra (she/her) is the founder of <strong>De La Practica</strong>, an experience design consultancy
            that focuses on accessible travel and tourism. Her mission is to help people of all abilities fully
            experience the places they live and the places they long to be.
          </p>
          <p>
            De La Parra's work is rooted in the belief that accessibility is about people, not paperwork. Accessibility
            is the practice of designing spaces and experiences that preserve everyone's independence and dignity by
            making those experiences usable by anyone.
          </p>
          <p>
            Accessibility work impacts the way all people move through the world, including those who may not consider
            themselves disabled, e.g., folks with invisible disabilities, episodic disability, and people experiencing
            the impact of aging. De La Parra believes that all people of all abilities have the right to fully
            experience the environment around them.
          </p>

          <aside
            class="callout rounded-lg border-l-4 border-(--color-primary-400) bg-(--accent-surface-color) px-6 py-5"
            aria-labelledby="ask-an-expert"
          >
            <Heading level="h3" size="h6" id="ask-an-expert" class="callout-title">Ask An Expert</Heading>
            <p>
              Jen Macias De La Parra is the digital accessibility advisor of record for Travel Oregon's <Link
                href="https://industry.traveloregon.com/programs/ask-an-expert/digital-accessibility-consultation/"
                isExternal>Ask an Expert program</Link
              >, supporting destinations, non-profits, and small businesses across the state. Oregon is the first
              Accessibility Verified state in the United States.
            </p>
          </aside>

          <p>
            De La Parra previously led global accessibility at Slalom, shaping how large organizations understand and
            implement access across complex digital environments. She is also the founder of Duende, an independent
            design studio focused on creative services and web design.
          </p>
          <p>De La Parra makes her home in beautiful Portland, Oregon.</p>
        </div>

        <Image
          src={heroImage}
          alt="Jen Macias De La Parra standing outdoors in a field of young fir trees at golden hour, smiling and looking off to one side, with rolling farmland behind her."
          class="aspect-[4/5] w-full rounded-lg object-cover md:sticky md:top-24"
          loading="lazy"
        />
      </div>
    </div>
  </section>
</DefaultLayout>

<style>
  .callout :global(.callout-title) {
    margin-block-end: 0.5rem;
    font-weight: 600;
    font-size: var(--font-size--1);
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .callout p {
    margin: 0;
  }
</style>

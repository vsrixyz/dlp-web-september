---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import { Accordion, AccordionItem, Heading, Link, Tabs, TabsList, TabsPanel, TabsTab } from 'accessible-astro-components'

const capabilities = [
  {
    title: 'Digital Ecosystem Discovery',
    description:
      'A clear picture of where the gaps are across all of it, not just the pages that get the most traffic.',
  },
  {
    title: 'Critical Issue Prioritization',
    description:
      'We tell you which problems to care about first and explain why, so you are working from a short list rather than a spreadsheet nobody reads.',
  },
  {
    title: 'Remediation Strategy',
    description: 'What to fix, in what order, and which person or vendor is doing it.',
  },
  {
    title: 'Accessibility Statement & Disclosure',
    description:
      'A page that names what is not working yet, what you are doing about it, and how a visitor can get help in the meantime. Travelers can tell when a statement is honest, and they respond to it.',
  },
  {
    title: 'Team Training & Operationalization',
    description:
      'We teach your staff to build this into the way they already work, so you are not hiring someone to run the same project again in two years.',
  },
  {
    title: 'Feedback Loop & Community Engagement',
    description:
      'A real way for disabled travelers to tell you what they ran into, and a process on your side for answering them.',
  },
  {
    title: 'Maturity Roadmap',
    description: 'Where your practice goes after the first round of fixes.',
  },
]

const approach = [
  {
    id: 'no-overlays',
    label: 'Practice not patches',
    title: "We don't use overlays or accessibility widgets",
    description:
      "There is no plug-in that makes a website completely work for disabled people. If you already have one running, we'll walk you through what it's actually doing and what it's leaving out.",
  },
  {
    id: 'past-requirements',
    label: 'Accessibility ≠ Usability',
    title: 'We aim past the requirements',
    description:
      'The federal standard is a checklist, and a site can satisfy all of it while still being completely unusable. We care about whether a visitor can finish what they came to do: find the room, buy the ticket, read the map.',
  },
  {
    id: 'teach-your-team',
    label: 'Empowering Practitioners',
    title: 'We teach you how to fish',
    description:
      "Small teams can't carry a consultant forever and shouldn't have to. We'd rather train your staff and hand the practice over than sell you a standing retainer.",
  },
]
---

<DefaultLayout title="De La Practica" useTitleTemplate={false}>
  <section class="my-24">
    <div class="narrow space-content container">
      <Heading level="h1">De La Practica</Heading>
      <p class="text-2xl">Digital accessibility for travel and tourism</p>
      <p>
        Disabled travelers plan carefully, because they have to. When your site can't tell them what they need to know,
        they'll make other plans.
      </p>
      <p>
        We help travel and tourism organizations make all of their digital touch points (websites, mobile apps, booking
        engines, PDF visitor guides, maps, event listings) accessible and usable for all visitors.
      </p>
      <div class="flex flex-wrap gap-4">
        <Link href="/contact" isButton type="primary" animateOnHover animationType="boop">
          Start with a conversation
        </Link>
      </div>
    </div>
  </section>

  <section
    class="border-y border-(--border-color-subtle) py-8"
    style="background-color: light-dark(var(--color-gray-100), var(--color-gray-800))"
  >
    <div class="container">
      <p class="italic">
        Digital accessibility advisor of record, <strong>Travel Oregon's Ask an Expert</strong> program · Oregon is the first
        Accessibility Verified state in the country
      </p>
    </div>
  </section>

  <section class="my-24">
    <div class="narrow space-content container">
      <Heading level="h2">This is not a small audience</Heading>
      <p>
        Travelers with mobility disabilities spend roughly <strong>$58.2 billion</strong> a year on travel. When surveyed
        by MMGY Global, the request that came up most often was better accessibility information <em>before a trip</em>.
        84% asked for it, putting it ahead of better infrastructure or more accessible lodging.
      </p>
      <p>Most of what these travelers want is information your organization already has.</p>
    </div>
  </section>

  <section class="my-24">
    <div class="narrow space-content container">
      <Heading level="h3">In the United States, there's a federal deadline looming</Heading>
      <p>
        New Department of Justice rules require state and local government websites and mobile apps to meet an
        accessibility standard called WCAG 2.1 Level AA. The deadline is <strong>April 26, 2027</strong> for places serving
        50,000 people or more, and <strong>April 26, 2028</strong> for smaller communities and special districts. Many destination
        organizations are covered directly, and others are covered through the contracts they hold with a city or state.
      </p>
      <p>Now is the time to build a practice.</p>
    </div>
  </section>

  <section class="my-24">
    <div class="narrow space-content container">
      <Heading level="h2">Accessibility is about people, not paperwork</Heading>
      <p>
        <strong>De La Practica</strong> works with you to build a sustainable accessibility practice that goes beyond compliance.
        Chasing bare compliance is a losing strategy that costs you more in the long run.
      </p>
      <p>
        Most accessibility work usually stops at the homepage, but travelers can face challenges across a number of
        surfaces. Mobile apps. Booking and ticketing flows. The visitor guide PDF, trail maps, event calendars, and many
        other forms of digital content.
      </p>
      <p>
        We find what's broken, sort it by what's costing you visitors, fix it in a sensible order, and equip your team
        with the knowledge and practices to keep your site usable.
      </p>
    </div>
    <div class="narrow container mt-12">
      <Accordion role="list">
        {
          capabilities.map((capability, index) => (
            <AccordionItem title={capability.title} headingLevel="h3" variant="chevron" open={index === 0}>
              <p>{capability.description}</p>
            </AccordionItem>
          ))
        }
      </Accordion>
    </div>
  </section>

  <section class="my-24">
    <div class="narrow space-content container">
      <Heading level="h2">How we work</Heading>
    </div>
    <div class="narrow container mt-8">
      <Tabs>
        <TabsList aria-label="How we work">
          {
            approach.map((item, index) => (
              <TabsTab id={`${item.id}-tab`} controls={`${item.id}-panel`} selected={index === 0}>
                {item.label}
              </TabsTab>
            ))
          }
        </TabsList>
        {
          approach.map((item, index) => (
            <TabsPanel id={`${item.id}-panel`} labelledby={`${item.id}-tab`} selected={index === 0} tabindex="0">
              <Heading level="h3" size="h5">
                {item.title}
              </Heading>
              <p>{item.description}</p>
            </TabsPanel>
          ))
        }
      </Tabs>
    </div>
  </section>

  <section class="my-24">
    <div class="container">
      <div class="grid gap-6 md:grid-cols-2">
        <div class="rounded-xl border border-(--border-color-subtle) p-6">
          <Heading level="h3" size="h5">Support for design teams</Heading>
          <p class="mt-3">
            You know accessibility matters, but the requirements can make it feel like you're choosing between your
            brand and the rules. We give teams the tools, training, and working sessions to build accessible work that
            still looks like theirs.
          </p>
          <p class="mt-4">
            <Link href="/contact">Learn more about support for design teams</Link>
          </p>
        </div>
        <div class="rounded-xl border border-(--border-color-subtle) p-6">
          <Heading level="h3" size="h5">Coaching for emerging practitioners</Heading>
          <p class="mt-3">
            Someone handed you accessibility, a target to hit, and very little support. You don't need another PDF, you
            need an expert in your corner. Hourly, on a sliding scale, and all budgets are welcome.
          </p>
          <p class="mt-4">
            <Link href="/contact">Learn more about coaching</Link>
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="my-24">
    <div class="narrow space-content container">
      <Heading level="h2">Start with a conversation</Heading>
      <p>
        A first call runs about half an hour. Tell us what you're working with, and we'll give you a straight read on
        where you stand and what it would take to improve it. If you'd rather take that away and do the work in house,
        that's a fine outcome and you're welcome to it.
      </p>
      <div class="flex flex-wrap gap-4">
        <Link href="/contact" isButton type="primary" animateOnHover animationType="boop">Book a call</Link>
      </div>
    </div>
  </section>
</DefaultLayout>

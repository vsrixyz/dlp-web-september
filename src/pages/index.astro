---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import {
  Accordion,
  AccordionItem,
  Heading,
  Link,
  Tabs,
  TabsList,
  TabsPanel,
  TabsTab,
} from 'accessible-astro-components'

const capabilities = [
  {
    title: 'Digital Ecosystem Discovery',
    description:
      'A structured assessment of your digital touchpoints — website, app, booking flows — to surface gaps and opportunities.',
  },
  {
    title: 'Critical Issue Prioritization',
    description: 'We review the discovery findings to determine which issues matter most and which to tackle first.',
  },
  {
    title: 'Remediation Strategy',
    description: 'A sequenced plan for fixing the prioritized issues, with clear timelines and accountability.',
  },
  {
    title: 'Accessibility Statement & Disclosure',
    description:
      'A real accessibility statement that names known issues and current efforts — not boilerplate legal language.',
  },
  {
    title: 'Team Training & Operationalization',
    description:
      "We teach your staff to build this into the way they already work, so you're not hiring someone to do this again in two years.",
  },
  {
    title: 'Feedback Loop & Community Engagement',
    description:
      'The intake, response, and follow-up mechanism that lets you hear from — and stay accountable to — the disabled travelers you serve.',
  },
  {
    title: 'Maturity Roadmap',
    description: 'A robust plan for growing from an emerging accessibility practice into an advancing one.',
  },
]

const approach = [
  {
    id: 'no-overlays',
    label: 'Practice not patches',
    title: 'No bandaids or widgets',
    description:
      "No plug-in makes a website work for disabled people. If you're already running one, we'll show you what it's actually doing, what it's missing, and help you build something more durable.",
  },
  {
    id: 'past-requirements',
    label: 'Beyond compliance',
    title: 'Accessibility ≠ Usability',
    description:
      'Most standards are a checklist — a site can be fully conformant and still unusable. We care whether a visitor can actually finish what they came to do: find the room, buy the ticket, read the map.',
  },
  {
    id: 'teach-your-team',
    label: 'Empowering practitioners',
    title: 'We are of the practice',
    description:
      "Small teams can't afford a consultant forever, and shouldn't have to. We give your team the tools, frameworks, and know-how to carry the work forward on their own.",
  },
]
---

<DefaultLayout
  title="De La Practica — Digital Accessibility for Travel &amp; Tourism"
  useTitleTemplate={false}
>
  <section class="my-24">
    <div class="narrow space-content container">
      <Heading level="h1">De La Practica</Heading>
      <p class="text-2xl">Digital accessibility for travel and tourism</p>
      <p>
        Disabled travelers plan carefully, because they have to. When your site can't tell them what they need to know,
        they'll make other plans.
      </p>
      <p>
        We help travel and tourism organizations make all of their digital touchpoints (websites, mobile apps, booking
        engines, PDF visitor guides, maps, event listings) accessible and usable for all visitors.
      </p>
      <div class="flex flex-wrap gap-4">
        <Link href="/contact" isButton type="primary" size="lg" animateOnHover animationType="boop">
          Start with a conversation
        </Link>
      </div>
    </div>
  </section>

  <section
    class="trust-bar border-y border-(--border-color-subtle) py-8"
    style="background-color: var(--surface-color)"
  >
    <div class="container">
      <p class="tracking-wide">
        Digital accessibility advisor of record,
        <strong
          ><Link
            href="https://industry.traveloregon.com/programs/ask-an-expert/digital-accessibility-consultation/"
            isExternal>Travel Oregon's Ask an Expert</Link
          ></strong
        >
        program.
      </p>
      <p class="tracking-wide">Oregon is the first Accessibility Verified state in the country.</p>
    </div>
  </section>

  <style>
    .trust-bar p {
      margin-inline: auto;
      max-inline-size: 50rem;
      color: var(--muted-foreground-color);
      line-height: 1.6;
      text-align: center;
    }

    .trust-bar p + p {
      margin-block-start: 0.25rem;
    }
  </style>

  <section class="my-24">
    <div class="narrow space-content container">
      <Heading level="h2">This is not a small audience</Heading>
      <p>
        Travelers with mobility disabilities spend roughly <strong>$58.2 billion</strong> a year on travel. When surveyed
        by MMGY Global, the request that came up most often was better accessibility information <em>before a trip</em>.
        Eighty-four percent asked for it, putting it ahead of better infrastructure or more accessible lodging.
      </p>
      <p>Most of what these travelers want is information your organization already has.</p>
    </div>
  </section>

  <section class="my-24">
    <div class="narrow space-content container">
      <Heading level="h2">In the United States, there's a federal deadline looming</Heading>
      <p>
        New Department of Justice rules require state and local government websites and mobile apps to meet an
        accessibility standard called WCAG 2.1 Level AA. The deadline is <strong>April 26, 2027</strong> for places serving
        50,000 people or more, and <strong>April 26, 2028</strong> for smaller communities and special districts. Many destination
        organizations are covered directly, and others are covered through the contracts they hold with a city or state.
      </p>
      <p>Now is the time to build a practice.</p>
    </div>
  </section>

  <section class="my-24">
    <div class="narrow space-content container">
      <Heading level="h2">Accessibility is about people, not paperwork</Heading>
      <p>
        <strong>De La Practica</strong> works with you to build a sustainable accessibility practice that goes beyond compliance.
        Chasing bare compliance is a losing strategy that costs you more in the long run.
      </p>
      <p>
        Most accessibility work stops at the homepage, but travelers can face challenges across a number of surfaces.
        Mobile apps. Booking and ticketing flows. The visitor guide PDF, trail maps, event calendars, and many other
        forms of digital content.
      </p>
      <p>
        We find what's broken, sort it by what's costing you visitors, fix it in a sensible order, and equip your team
        with the knowledge and practices to keep your site usable.
      </p>
    </div>
    <div class="narrow container mt-12">
      <Accordion role="list">
        {
          capabilities.map((capability, index) => (
            <AccordionItem title={capability.title} headingLevel="h3" variant="chevron" open={index === 0}>
              <p>{capability.description}</p>
            </AccordionItem>
          ))
        }
      </Accordion>
    </div>
  </section>

  <section class="my-24">
    <div class="narrow space-content container">
      <Heading level="h2">How we work</Heading>
    </div>
    <div class="narrow how-we-work-tabs container mt-8">
      <Tabs>
        <TabsList aria-label="How we work">
          {
            approach.map((item, index) => (
              <TabsTab id={`${item.id}-tab`} controls={`${item.id}-panel`} selected={index === 0}>
                {item.label}
              </TabsTab>
            ))
          }
        </TabsList>
        {
          approach.map((item, index) => (
            <TabsPanel id={`${item.id}-panel`} labelledby={`${item.id}-tab`} selected={index === 0} tabindex="0">
              <Heading level="h3" size="h5">
                {item.title}
              </Heading>
              <p>{item.description}</p>
            </TabsPanel>
          ))
        }
      </Tabs>
    </div>
  </section>

  <style>
    .how-we-work-tabs :global(.tab) {
      border-width: 1px;
      border-color: var(--color-primary-300);
      padding-inline: var(--space-m);
      padding-block: 2rem;
    }

    .how-we-work-tabs :global(.tab[aria-selected='true']),
    .how-we-work-tabs :global(.tab:hover),
    .how-we-work-tabs :global(.tab:focus-visible) {
      box-shadow: 0 0 0 0.25rem var(--accent-ring-color);
      border-color: var(--color-primary-500);
      background-color: var(--color-primary-500);
      color: var(--color-neutral-100);
    }

    .how-we-work-tabs :global(.tab-panel) {
      border-width: 1px;
      border-color: var(--color-primary-300);
      padding: var(--space-l);
    }
  </style>

  <section class="my-24">
    <div class="container">
      <div class="grid gap-6 md:grid-cols-2">
        <div class="rounded-xl border border-(--border-color-subtle) p-6">
          <Heading level="h3" size="h5">Support for design teams</Heading>
          <p class="mt-3">
            You know accessibility matters, but the requirements can make it feel like you're choosing between your
            brand and the rules. We give teams the tools, training, and working sessions to build accessible work that
            still looks like theirs.
          </p>
          <p class="mt-4">
            <Link href="/contact">Schedule a conversation to learn more</Link>
          </p>
        </div>
        <div class="rounded-xl border border-(--border-color-subtle) p-6">
          <Heading level="h3" size="h5">Coaching for emerging practitioners</Heading>
          <p class="mt-3">
            Someone handed you accessibility, a target to hit, and very little support. You don't need another PDF, you
            need an expert in your corner. Hourly, on a sliding scale, and all budgets are welcome.
          </p>
          <p class="mt-4">
            <Link href="/contact">Schedule a conversation to learn more</Link>
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="closing-cta-band my-24 py-16">
    <div class="narrow space-content container">
      <Heading level="h2">Start with a conversation</Heading>
      <p>
        This work can feel like a lot. It doesn't have to be — with the right support, it's genuinely empowering, and a
        real edge for your destination. Let's have an open conversation about what you're up against.
      </p>
      <div class="flex flex-wrap gap-4">
        <Link href="/contact" isButton type="primary" size="lg" animateOnHover animationType="boop"
          >Schedule a call</Link
        >
      </div>
    </div>
  </section>
</DefaultLayout>

<style>
  .closing-cta-band {
    clip-path: inset(0 -100vmax);
    box-shadow: 0 0 0 100vmax var(--accent-surface-color);
    background-color: var(--accent-surface-color);
  }

  /*
   * Dark mode only: the solid primary button reaches ~2.7:1 against the deep
   * oxblood band, short of the 3:1 WCAG 1.4.11 asks of a control's boundary.
   * A hairline ring defines the edge without changing the fill. In light mode
   * the same button sits at 4.08:1 against the blue band and needs no ring.
   */
  :global(.darkmode) .closing-cta-band :global(.button) {
    outline: 1px solid var(--foreground-color);
    outline-offset: 0;
  }
</style>

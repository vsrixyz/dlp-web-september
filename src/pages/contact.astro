---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PageHeader from '@components/PageHeader.astro'
import { Form, Input, Button, Textarea, Heading } from 'accessible-astro-components'

// This site builds to static files, which cannot process a form submission on
// their own. Point this at your form handler (Netlify Forms, Formspree, or an
// Astro server endpoint) before launch. Until then the form will not deliver.
const formAction = '/thank-you'
---

<DefaultLayout
  title="Contact"
  description="Start with a conversation. A first call runs about half an hour and gives you a straight read on where you stand."
>
  <PageHeader
    title="Start with a conversation"
    subtitle="A first call runs about half an hour."
    bgType="bordered"
  />

  <section class="my-16">
    <div class="narrow space-content container">
      <Heading level="h2">Send a message</Heading>
      <p>
        Tell us what you're working with. We'll give you a straight read on where you stand and what it would take to
        improve it.
      </p>
      <Form name="contact" action={formAction} method="post">
        <Input name="name" label="Name" required autocomplete="name" />
        <Input name="email" label="Email address" type="email" required autocomplete="email" />
        <Input name="organization" label="Organization" autocomplete="organization" />
        <Textarea name="message" label="What are you working with?" required />
        <Button htmlType="submit" type="primary">Send message</Button>
      </Form>
    </div>
  </section>
</DefaultLayout>

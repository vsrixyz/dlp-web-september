---
import themeConfig from '@theme-config'
import { Heading, Link } from 'accessible-astro-components'

const currentYear = new Date().getFullYear()

const footerLinks = themeConfig.navigation.items.flatMap((item) => {
  if (item.type === 'dropdown') {
    return item.items.filter((subItem) => !subItem.external)
  }

  if (!item.type || item.type === 'link') {
    return item.external ? [] : [item]
  }

  return []
})

const socialLinks = themeConfig.socials ?? []
---

<footer>
  <section class="py-16">
    <div class="container grid grid-cols-1 gap-10 md:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]">
      <div class="space-content">
        <Heading level="h2" size="h4">{themeConfig.name}</Heading>
        <p>
          Digital accessibility for travel and tourism. We help destinations, nonprofits, and small businesses make
          every digital touchpoint usable for all visitors.
        </p>
        <p>
          Digital accessibility advisor of record, Travel Oregon's <span class="whitespace-nowrap">Ask an Expert</span> program.
        </p>
      </div>
      <div class="md:justify-self-end">
        {
          footerLinks.length > 0 && (
            <>
              <Heading level="h2" size="h6" class="mb-4">
                Pages
              </Heading>
              <ul class="flex flex-col gap-2">
                {footerLinks.map((link) => (
                  <li>
                    <Link href={link.href}>{link.label}</Link>
                  </li>
                ))}
              </ul>
            </>
          )
        }
        {
          socialLinks.length > 0 && (
            <>
              <Heading level="h2" size="h6" class="mt-8 mb-4">
                Socials
              </Heading>
              <ul class="flex flex-col gap-2">
                {socialLinks.map((link) => (
                  <li>
                    <Link href={link.href} isExternal>
                      {link.label}
                    </Link>
                  </li>
                ))}
              </ul>
            </>
          )
        }
      </div>
    </div>
  </section>
  <section class="py-8">
    <div class="container flex flex-col gap-2 md:flex-row md:justify-between">
      <p>
        &copy; {currentYear} De La Practica LLC - <Link href="https://accessible-astro.incluud.dev/" isExternal
          >Accessible Astro</Link
        >
      </p>
      <p><Link href="/accessibility">Accessibility Statement</Link></p>
    </div>
  </section>
</footer>

<style>
  footer {
    --foreground-color: var(--color-neutral-100);
    --link-color: var(--color-secondary-100);
    --link-hover-color: var(--color-secondary-200);
    --border-color-subtle: oklch(from var(--brand-primary) 30% c h);
    /*
     * The footer paints its own dark blue over whatever the page theme is, so
     * it has to restate the focus ring too. The light-mode salmon reaches only
     * 2.3:1 here, under the 3:1 SC 1.4.11 asks of a focus indicator; the
     * lighter ramp step clears it in both themes.
     */
    --outline-color: var(--color-outline-100);

    background-color: oklch(from var(--brand-primary) 28% c h);
    color: var(--foreground-color);
  }

  footer section {
    border-top: 1px solid var(--border-color-subtle);
  }

  footer section:last-of-type {
    background-color: oklch(from var(--brand-primary) 12% c h);
  }
</style>
